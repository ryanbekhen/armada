    "usage": {}
   }
  },
  {
   "assignment": {
    "replicas": [
     {
      "id": "web-r1-a",
      "app": "web",
      "revision": "web--r1",
      "image": "nginx:1",
      "command": [
       "/bin/web"
      ],
      "args": [
       "--x"
      ],
      "env": [
       {
        "name": "A",
        "value": "1"
       },
       {
        "name": "S",
        "value": "secret",
        "ref": "s/v1"
       }
      ],
      "port": 8080,
      "memoryBytes": "268435456",
      "nanoCpus": "500000000",
      "pidsLimit": "1024",
      "liveness": {
       "path": "/live",
       "periodMs": "20",
       "failureThreshold": 2
      },
      "cpuReserveMillis": "100"
     }
    ]
   },
   "op": "assign"
  },
  {
   "expect": [
    "step restarted",
    "report {\"replicas\":[{\"id\":\"web-r1-a\",\"state\":\"running\",\"containerId\":\"armada-web-r1-a-2\",\"address\":\"10.0.0.2:31800\",\"message\":\"restarted: liveness probe failed: HTTP 500\",\"ready\":true}]}",
    "calls inspect {\"id\":\"armada-web-r1-a-1\"}\ninspect {\"id\":\"armada-web-r1-a-2\"}\nlist {\"labels\":{\"armada.managed\":\"true\"}}\npull {\"auth\":null,\"image\":\"nginx:1\"}\nremove {\"id\":\"armada-web-r1-a-1\"}\nrun {\"spec\":{\"name\":\"armada-web-r1-a\",\"image\":\"nginx:1\",\"entrypoint\":[\"/bin/web\"],\"cmd\":[\"--x\"],\"env\":[\"A=1\",\"S=secret\"],\"labels\":{\"armada.app\":\"web\",\"armada.managed\":\"true\",\"armada.replica\":\"web-r1-a\",\"armada.revision\":\"web--r1\",\"armada.spec-hash\":\"9fa79282a5d24a58308f9c7e5ea2aded\"},\"port\":8080,\"hostIp\":\"10.0.0.2\",\"memoryBytes\":268435456,\"nanoCpus\":500000000,\"cpuReserveMillis\":100,\"pidsLimit\":1024}}\nstop {\"graceMs\":10000,\"id\":\"armada-web-r1-a-1\"}",
    "files "
   ],
   "name": "restarted",
   "op": "until"
  },
  {
   "expect": [
    "step the note was reported",
    "report {\"replicas\":[{\"id\":\"web-r1-a\",\"state\":\"running\",\"containerId\":\"armada-web-r1-a-2\",\"address\":\"10.0.0.2:31800\",\"ready\":true}]}",
    "calls list {\"labels\":{\"armada.managed\":\"true\"}}",
    "files "
   ],
   "name": "the note was reported",
   "op": "reconcile"
  }
 ]
