{
 "name": "TestAgentParity/no_secrets_or_volumes_on_the_node",
 "opts": {
  "bootNs": 1767222000000000000,
  "bridge": "",
  "crashBaseNs": 1000000000,
  "dns": "",
  "encodes": false,
  "exec": true,
  "members": true,
  "move": false,
  "network": false,
  "networkKey": "",
  "noSecretsDir": true,
  "proxy": false,
  "sandbox": false,
  "side": false,
  "stats": true,
  "unpublished": false,
  "volumes": true,
  "volumesDir": false
 },
 "steps": [
  {
   "assignment": {
    "replicas": [
     {
      "id": "web-r1-a",
      "app": "web",
      "revision": "web--r1",
      "image": "nginx:1",
      "command": [
       "/bin/web"
      ],
      "args": [
       "--x"
      ],
      "env": [
       {
        "name": "A",
        "value": "1"
       },
       {
        "name": "S",
        "value": "secret",
        "ref": "s/v1"
       }
      ],
      "memoryBytes": "268435456",
      "nanoCpus": "500000000",
      "pidsLimit": "1024",
      "readiness": {
       "path": "/r",
       "initialDelayMs": "3600000"
      },
      "secretFiles": [
       {
        "path": "/x",
        "data": "eA=="
       }
      ],
      "cpuReserveMillis": "100"
     },
     {
      "id": "web-r1-b",
      "app": "web",
      "revision": "web--r1",
      "image": "nginx:1",
      "command": [
       "/bin/web"
      ],
      "args": [
       "--x"
      ],
      "env": [
       {
        "name": "A",
        "value": "1"
       },
       {
        "name": "S",
        "value": "secret",
        "ref": "s/v1"
       }
      ],
      "memoryBytes": "268435456",
      "nanoCpus": "500000000",
      "pidsLimit": "1024",
      "readiness": {
       "path": "/r",
       "initialDelayMs": "3600000"
      },
      "cpuReserveMillis": "100",
      "volumes": [
       {
        "name": "data",
        "path": "/data"
       }
      ]
     }
    ]
   },
   "op": "assign"
  },
  {
   "expect": [
    "step refused",
    "report {\"replicas\":[{\"id\":\"web-r1-a\",\"state\":\"failed\",\"message\":\"this node cannot mount secret files: the agent has no tmpfs secrets directory (see --secrets-dir)\"},{\"id\":\"web-r1-b\",\"state\":\"failed\",\"message\":\"this node cannot mount volumes\"}]}",
    "calls list {\"labels\":{\"armada.managed\":\"true\"}}\npull {\"auth\":null,\"image\":\"nginx:1\"}",
    "files "
   ],
   "name": "refused",
   "op": "reconcile"
  }
 ]
}
