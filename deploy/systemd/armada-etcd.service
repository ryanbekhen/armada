[Unit]
Description=Armada control plane state (this server's etcd member)
Documentation=https://github.com/ryanbekhen/armada
# Runs the runtime pack's pinned etcd on this server's member (ADR 0055).
# armada-server.service wants it, so starting the server starts it.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The server's flags: armadad etcd reads --data-dir and ignores the rest.
EnvironmentFile=-/etc/armada/server.env
ExecStart=/usr/local/bin/armadad etcd --data-dir /var/lib/armada $ARMADA_SERVER_FLAGS
UMask=0077
Restart=always
RestartSec=2
# 78: the server keeps its state in armada-kv (ADR 0057), whose unit runs
# its member; not a failure, and not restarted.
SuccessExitStatus=78
RestartPreventExitStatus=78
LimitNOFILE=65536
# etcd closes its write-ahead log on SIGTERM; give a busy member time.
TimeoutStopSec=60
# Under memory pressure the kernel kills workloads (at 0) before the
# control plane's state.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
