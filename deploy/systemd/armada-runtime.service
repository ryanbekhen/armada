[Unit]
Description=Armada embedded container runtime (containerd)
Documentation=https://github.com/ryanbekhen/armada
After=network-online.target
Wants=network-online.target
# Started by armada-server or armada-agent. It exits at once on nodes that
# are not initialized yet.

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/armadad runtime --data-dir /var/lib/armada
RuntimeDirectory=armada
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Containers keep running while containerd restarts or is upgraded: only
# containerd itself is stopped, not the shims in its cgroup.
KillMode=process
Delegate=yes
Restart=on-failure
RestartSec=2
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
