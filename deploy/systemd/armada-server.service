[Unit]
Description=Armada control plane server
Documentation=https://github.com/ryanbekhen/armada
# A server machine runs three units (ADR 0055): this server's etcd member
# (armada-etcd), the control plane (this one), and the node's agent
# (armada-agent), so enabling and starting this one is enough. The server
# waits for its member; the agent holds the data directory's lock.
After=network-online.target armada-etcd.service armada-agent.service
Wants=network-online.target armada-etcd.service armada-agent.service

[Service]
Type=simple
# Extra flags, e.g. ARMADA_SERVER_FLAGS="--acme-email ops@example.com".
# The agent's own flags go in /etc/armada/agent.env (ARMADA_AGENT_FLAGS).
EnvironmentFile=-/etc/armada/server.env
ExecStart=/usr/local/bin/armadad server --data-dir /var/lib/armada $ARMADA_SERVER_FLAGS
RuntimeDirectory=armada
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
Restart=always
RestartSec=2
LimitNOFILE=65536
# Under memory pressure the kernel kills workloads (at 0) before the
# control plane; the container shims are at -999.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
