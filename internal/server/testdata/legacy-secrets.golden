app: "api"
revision: "api--r1"
image: "ghcr.io/example/api:1"
env: {
  name: "LOG_LEVEL"
  value: "info"
}
env: {
  name: "MAIL_PASSWORD"
  value: "mail"
  ref: "smtp-pass@v1"
}
env: {
  name: "DATABASE_URL"
  value: "postgres://db"
  ref: "database-url@v1"
}
env: {
  name: "JWT_SECRET"
  value: "jwt"
  ref: "jwt-secret@v1"
}
env: {
  name: "REDIS_URL"
  value: "redis://r"
  ref: "redis-url@v1"
}
env: {
  name: "SMTP_PASS"
  value: "mail"
  ref: "smtp-pass@v1"
}
env: {
  name: "ARMADA_APP"
  value: "api"
}
env: {
  name: "ARMADA_REVISION"
  value: "api--r1"
}
env: {
  name: "ARMADA_REPLICA"
}
memory_bytes: 268435456
pids_limit: 1024
secret_files: {
  path: "/run/tls/key.pem"
  data: "KEY"
  ref: "tls-key@v1"
}
registry: {
  server: "ghcr.io"
  username: "bot"
  password: "ghp"
  ref: "registry-password@v1"
}
cpu_reserve_millis: 100
